---
import Layout from '../layouts/Layout.astro';
import { getReadBooks } from '../utils/goodreads';

import site from '../site.config';

// Fetch read books from Goodreads RSS
const books = await getReadBooks();

const REVIEW_PREVIEW_LENGTH = 500;

function getReviewPreview(review?: string) {
	if (!review) {
		return {
			text: "Didn't write a review for this one, but it was a great read!",
			isTruncated: false
		};
	}

	if (review.length <= REVIEW_PREVIEW_LENGTH) {
		return { text: review, isTruncated: false };
	}

	const lastWordBoundary = review.lastIndexOf(' ', REVIEW_PREVIEW_LENGTH);
	const cutoff = lastWordBoundary > 0 ? lastWordBoundary : REVIEW_PREVIEW_LENGTH;

	return {
		text: `${review.slice(0, cutoff).trimEnd()}...`,
		isTruncated: true
	};
}
---

<Layout title={`Books - ${site.title}`} description="Books I've been reading">
	<div class="nes-container is-dark with-title">
		<p class="title">📚 Bookshelf</p>
		
		<div class="nes-container is-rounded" style="margin-bottom: 2rem;">
			<div style="margin-bottom: 2rem;">
				<h2 style="margin: 0;">Reading Journey</h2>
			</div>
			
			<p style="font-size: 0.8rem; line-height: 1.8; margin-bottom: 2rem;">
				Here are some of the books I've been reading lately. These ratings and reviews are from my Goodreads account.
			</p>
			
			<!-- Books List -->
			<div class="books-list">
				{books.map((book) => {
					const reviewPreview = getReviewPreview(book.review);
					const userRating = book.userRating ?? 0;
					const hasRating = userRating > 0;

					return (
						<div class="nes-container is-rounded with-title is-dark book-item">
							<p class="title">{book.title}</p>
							
							<div class="book-content">
								<div class="book-cover">
									<img src={book.cover} alt={book.title} />
								</div>
								
								<div class="book-details">
									<div class="book-author-wrap">
										<span class="book-author">by {book.author}</span>
									</div>
									<div class="rating" aria-label={hasRating ? `My rating: ${userRating} out of 5` : 'I have not rated this book'}>
										{hasRating ? (
											<>
												<div class="rating-stars" aria-hidden="true">
													{Array.from({ length: 5 }).map((_, i) => (
														<span class="rating-star" style={`--fill: ${i < userRating ? 100 : 0}%`}>★</span>
													))}
												</div>
											</>
										) : (
											<span class="rating-value">Not rated</span>
										)}
									</div>

									<div class={`review-text ${!book.review ? 'placeholder' : ''}`}>
										{reviewPreview.text}
									</div>

									<div class="book-link-wrap">
										<a href={book.url} target="_blank" rel="noopener noreferrer" class="nes-btn is-primary book-link">
											{reviewPreview.isTruncated ? 'Read full review on Goodreads →' : 'View on Goodreads →'}
										</a>
									</div>
								</div>
							</div>
						</div>
					);
				})}
			</div>
			
			<div style="text-align: center; margin-top: 3rem;">
				<a href="https://www.goodreads.com/user/show/155924638-farhan-hasin-chowdhury" target="_blank" rel="noopener noreferrer" class="nes-btn is-primary">
					View on Goodreads →
				</a>
				<a href="/articles" class="nes-btn is-success">Browse Articles</a>
			</div>
		</div>
		</div>
	
	<style>
		.books-list {
			display: flex;
			flex-direction: column;
			gap: 1.5rem;
		}
		
		.book-item {
			border: 4px solid #fff !important;
		}
		
		.book-item .title {
			color: #92cc41 !important;
			font-size: 0.9rem !important;
			line-height: 1.5;
			word-break: break-word;
		}

		.book-content {
			display: flex;
			gap: 1.5rem;
			margin-bottom: 1rem;
			align-items: flex-start;
		}

		.book-details {
			flex: 1;
			min-width: 0;
		}

		.book-author-wrap {
			min-width: 0;
			margin-bottom: 0.55rem;
		}

		.book-author {
			font-size: 0.7rem;
			color: #ccc;
			word-break: break-word;
		}
		
		.book-cover {
			flex-shrink: 0;
		}
		
		.book-cover img {
			width: 80px;
			height: 120px;
			object-fit: cover;
			border: 3px solid #fff;
		}
		
		.rating {
			display: flex;
			align-items: center;
			flex-wrap: wrap;
			gap: 2px;
			flex-shrink: 0;
			margin-bottom: 1.25rem;
		}

		.rating-value {
			font-size: 0.55rem;
			line-height: 1.5;
		}

		.rating-stars {
			display: flex;
			gap: 2px;
		}

		.rating-star {
			background: linear-gradient(
				90deg,
				#92cc41 var(--fill),
				#666 var(--fill)
			);
			background-clip: text;
			-webkit-background-clip: text;
			color: transparent;
			-webkit-text-fill-color: transparent;
			font-size: 0.8rem;
		}

		.rating-value {
			color: #fff;
		}
		
		.review-text {
			font-size: 0.7rem;
			line-height: 1.6;
				color: #fff;
				padding: 1rem;
			background-color: rgba(146, 204, 65, 0.1);
			border: 2px solid #92cc41;
			font-family: monospace;
			word-break: break-word;
			overflow-wrap: anywhere;
		}

		.review-text.placeholder {
			background-color: rgba(255, 255, 255, 0.05);
			border: 2px dashed #555;
			color: #888;
			font-style: italic;
		}

		.book-link-wrap {
			margin-top: 1rem;
		}

		.book-link {
			font-size: 0.6rem !important;
			padding: 8px 12px !important;
			display: inline-block;
		}
		
		@media (max-width: 768px) {
			.book-item .title {
				font-size: 0.8rem !important;
			}

			.book-content {
				flex-direction: column;
				gap: 1rem;
				margin-bottom: 0;
			}

			.book-author {
				font-size: 0.62rem;
				line-height: 1.5;
			}
			
			.book-cover img {
				width: 60px;
				height: 90px;
				border-width: 2px;
			}

			.rating-star {
				font-size: 0.7rem !important;
			}

			.rating-value {
				font-size: 0.5rem;
			}
			
			.review-text {
				font-size: 0.6rem;
				padding: 0.85rem;
				line-height: 1.65;
			}

			.book-link {
				width: 100%;
				font-size: 0.58rem !important;
				padding: 8px 10px !important;
				text-align: center;
				line-height: 1.4;
			}
		}
	</style>
</Layout>
